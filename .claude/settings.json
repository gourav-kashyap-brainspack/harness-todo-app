{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_README": "STAGED HARNESS SETTINGS — review, then activate with:  mv .claude/settings.harness.json .claude/settings.json  (the auto-mode guard blocks the agent from writing settings.json directly because it widens permissions). Keep .claude/settings.local.json for your personal overrides.",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(git worktree:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(tsc:*)",
      "Bash(eslint:*)",
      "Bash(jest:*)",
      "Bash(react-native:*)",
      "Bash(./gradlew:*)",
      "Bash(pod:*)",
      "Bash(xcodebuild:*)",
      "Bash(gh:*)",
      "Bash(graphify:*)",
      "Bash(mkdir:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease origin main:*)",
      "Bash(git push --force-with-lease * main:*)",
      "Bash(git push origin main:*)",
      "Bash(git push * origin main)",
      "Bash(git push * origin main:*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * +main*)",
      "Bash(gh pr create * --base main*)",
      "Bash(gh pr create * -B main*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh pr merge * --base main*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/main-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|mcp__filesystem__write_file|mcp__filesystem__edit_file|mcp__filesystem__move_file|mcp__filesystem__create_directory",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-authz.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/docs/graph/CHECKPOINT.md\" 2>/dev/null; awk 'BEGIN{p=1} /^## Tasks/{p=0} /^## Next runnable/{p=1} p' \"$CLAUDE_PROJECT_DIR/docs/graph/STATUS.md\" 2>/dev/null; echo '_(per-task tables trimmed at session start — full board: docs/graph/STATUS.md)_'"
          }
        ]
      }
    ]
  }
}
